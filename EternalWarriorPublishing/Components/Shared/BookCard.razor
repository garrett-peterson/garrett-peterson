@using EternalWarriorPublishing.Models

<article class="book-card">
    <a class="book-card-link" href="/books/@Book.Slug">
        <div class="book-cover">
            @Book.Initials
        </div>

        <div class="book-info">
            <h3>@Book.Title</h3>
            <p class="book-genre">@Book.Genre</p>
            <p>@Book.Description</p>
            <span class="book-details-link">View Details</span>
        </div>
    </a>
</article>

@code {
    [Parameter]
    public Book Book { get; set; } = new();
}