@page "/about"
@rendermode InteractiveServer

<PageTitle>About Us | Eternal Warrior Publishing</PageTitle>

<section class="page-hero-section">
    <div class="hero-content">
        <p class="eyebrow">Never Stop Believing</p>
        <h1>About Us</h1>
        <p class="hero-description">
            Learn more about the team behind Eternal Warrior Publishing.
        </p>
    </div>
</section>

<section class="about-section">
    <div class="about-content">
        <p class="eyebrow">Who We Are</p>
        <h2>We believe myth-making can point readers toward the true harbor.</h2>
        <p>
            Eternal Warrior Publishing is a fictional independent publishing company devoted to mythic,
            hopeful, and morally serious storytelling. We believe stories are not merely escapes from
            reality. At their best, they are acts of sub-creation: imperfect but meaningful attempts to
            reflect truth, beauty, courage, repentance, and light.
        </p>
    </div>
</section>

<section class="values-section">
    <div class="section-heading">
        <p class="eyebrow">What We Believe</p>
        <h2>Stories should leave readers stronger than they were before.</h2>
    </div>

    <div class="values-grid">
        @foreach (var value in CompanyValues)
        {
            <article class="value-card">
                <div class="value-icon">@value.Icon</div>
                <h3>@value.Title</h3>
                <p>@value.Description</p>
            </article>
        }
    </div>
</section>

<section class="team-section">
    <div class="section-heading">
        <p class="eyebrow">Our Team</p>
        <h2>The people behind the pages</h2>
    </div>

    <div class="team-grid">
        @foreach (var member in TeamMembers)
        {
            <article class="team-card">
                <div class="team-avatar">
                    @member.Initials
                </div>

                <div class="team-info">
                    <h3>@member.Name</h3>
                    <p class="team-role">@member.Role</p>
                    <p>@member.Description</p>
                </div>
            </article>
        }
    </div>
</section>

<section class="timeline-section">
    <div class="section-heading">
        <p class="eyebrow">Our Journey</p>
        <h2>How Eternal Warrior Publishing began</h2>
    </div>

    <div class="timeline">
        @foreach (var item in TimelineItems)
        {
            <article class="timeline-item">
                <span class="timeline-year">@item.Year</span>
                <div>
                    <h3>@item.Title</h3>
                    <p>@item.Description</p>
                </div>
            </article>
        }
    </div>
</section>

<section class="about-cta-section">
    <div class="about-cta-content">
        <p class="eyebrow">Join the Quest</p>
        <h2>Looking for your next heroic read?</h2>
        <p>
            Explore our catalog of bold adventures, unforgettable characters, and stories written
            for readers who still believe light can overcome darkness.
        </p>

        <a class="primary-button" href="/books">
            Browse Our Books
        </a>
    </div>
</section>

